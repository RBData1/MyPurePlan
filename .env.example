# Copy this file to .env.local, or run configure-supabase.cmd after getting your project details.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Use the project's publishable key (sb_publishable_...) or legacy anon key. NEVER use service_role/secret.
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
